{
  "name": "minecraft-party",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "assets": {
    "directory": "../website/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DIRECTORY", "class_name": "PartyDirectory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyDirectory"] }],
  "observability": { "enabled": false }
}
